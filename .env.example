# Gmail account used to authenticate with smtp.gmail.com.
GMAIL_USER=your-account@gmail.com

# Generate this at https://myaccount.google.com/apppasswords.
# This is not your regular Gmail password.
GMAIL_APP_PASSWORD=your-16-character-app-password

# Inbox that receives contact requests. Defaults to GMAIL_USER when omitted.
CONTACT_TO_EMAIL=inbox@example.com

# Optional display name used in the From header.
CONTACT_FROM_NAME=Southern Edge Services Website
